# Copy to .env (install.sh does this and fills in WEBHOOK_TOKEN for you).

# Shared secret Rootly sends in the X-Webhook-Token header.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=

# Nest Mini. NEST_IP is tried first; NEST_NAME (the name shown in the
# Google Home app) is used for discovery if the IP is blank or unreachable.
NEST_IP=
NEST_NAME=

# Volume levels in percent (0-100) and durations in seconds.
ALARM_VOLUME=90
ALARM_TIMEOUT_SECONDS=600
TEST_VOLUME=40
TEST_DURATION_SECONDS=15

# Sound to play. Relative paths are relative to the repo root.
ALARM_FILE=sounds/alarm.mp3

# Webhook listener. Keep this on localhost; cloudflared forwards to it.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080

# LAN address the Nest fetches the alarm file from. Must be this machine's
# LAN IP (not 127.0.0.1) and a port nothing else on the machine is using.
MEDIA_HOST=192.168.1.10
MEDIA_PORT=8081
